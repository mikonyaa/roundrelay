{
  "name": "roundrelay",
  "version": "0.1.1-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts *.ts",
    "test:unit": "vitest run",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "package:web": "node scripts/package.mjs",
    "test:production": "node scripts/test-production.mjs",
    "demo:record": "node scripts/demo.mjs",
    "fixtures": "tsx scripts/fixtures.ts",
    "notices": "node scripts/notices.mjs",
    "test:suspension": "node scripts/run-suspension.mjs",
    "format": "prettier --write src tests scripts docs *.ts *.js *.json *.md .github"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "papaparse": "5.7.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.4",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "globals": "16.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/papaparse": "5.3.16",
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "prettier": "3.6.2"
  }
}
